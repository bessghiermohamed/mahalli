# ============================================================
# Mahalli — Environment variables
# انسخ هذا الملف إلى .env.local ثم املأ القيم الحقيقية
# ============================================================

# Supabase project URL (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase PUBLISHABLE (anon) key — safe to expose in the browser.
# New format: sb_publishable_... | Legacy format: the "anon" JWT
# ⚠️ NEVER put a secret/service key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Public site URL used for SEO metadata, canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
